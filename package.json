{
    "name": "team-alpha-admin",
    "version": "1.0.0",
    "type": "module",
    "description": "Root package for Team Alpha Admin",
    "main": "api/index.js",
    "scripts": {
        "install:all": "npm install --prefix frontend && npm install --prefix backend",
        "dev:frontend": "npm run dev --prefix frontend",
        "dev:backend": "npm run dev --prefix backend",
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
        "vercel-build": "cd frontend && npm install --legacy-peer-deps && npx vite build"
    },
    "dependencies": {
        "cloudinary": "^2.9.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "mongoose": "^8.1.1",
        "multer": "^2.1.0",
        "multer-storage-cloudinary": "^4.0.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}